# Copy this file to .env and fill in your own values
PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/sevenstar

# OR MongoDB Atlas (cloud) example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sevenstar

JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Comma separated list of origins allowed to call this API
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000
