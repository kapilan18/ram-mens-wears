# Copy this file to .env and replace the placeholder values.
PORT=5000

MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Comma-separated frontend origins. Add the deployed frontend URL in Render.
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
